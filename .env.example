# Supply secrets in the process environment; never put them in command arguments.
DSH_VAULT_WEBDAV_URL=https://dav.example.com/backups/dsh/
# HTTP is also supported; it exposes WebDAV credentials on the connection.
# Snapshot encryption defaults on; plaintext requires explicit opt-in. Prefer HTTPS.
DSH_VAULT_WEBDAV_USERNAME=
DSH_VAULT_WEBDAV_PASSWORD=
DSH_VAULT_PASSPHRASE=
# Also used by encrypted automatic backups when enabled. Alternatively unlock
# automatic backup in the UI for this Harness process only; never saved to files.
# CLI requires an explicit source or target home. No automatic .env loading.
